# OpenAI API 配置（必填）
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI 模型名称（必填）
# 推荐：gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# OpenAI API Base URL（可选）
# 如果使用 Azure OpenAI 或其他兼容服务，设置此项
# OPENAI_BASE_URL=https://your-endpoint.openai.azure.com/v1

# agent-browser CLI 路径（可选）
# 默认从系统 PATH 查找，通常不需要设置
# AGENT_BROWSER_CLI=/usr/local/bin/agent-browser

# 浏览器默认配置（可选，运行时可覆盖）
# 是否显示浏览器窗口（隔离模式下生效）
# AGENT_BROWSER_HEADED=true

# 浏览器用户数据目录（隔离模式下生效）
# 默认在 backend/.profiles/<session_id> 创建临时 profile
# AGENT_BROWSER_PROFILE=/path/to/custom/profile

# CDP 调试端口（现有浏览器模式下生效）
# 运行时由 discover_cdp_url() 自动探测，通常不需要手动设置
# AGENT_BROWSER_CDP=http://localhost:9222

# 日志级别（可选）
# LOG_LEVEL=INFO
