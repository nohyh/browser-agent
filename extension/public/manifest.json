{
  "manifest_version": 3,
  "name": "Browser Agent",
  "version": "1.0.0",
  "description": "Chrome Side Panel Extension",
  "permissions": [
    "sidePanel"
  ],
  "action": {
    "default_title": "Browser Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
